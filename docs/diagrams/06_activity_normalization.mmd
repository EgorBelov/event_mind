%%{init: {'theme':'base','themeVariables':{'fontSize':'19px','fontFamily':'Arial'},'flowchart':{'htmlLabels':true,'nodeSpacing':40,'rankSpacing':55}}}%%
flowchart LR
    classDef start fill:#0F2C68,stroke:#0F2C68,color:#fff
    classDef proc fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef ai fill:#f3e5f5,stroke:#6a1b9a,color:#000
    classDef dec fill:#fff9c4,stroke:#f57f17,color:#000
    classDef db fill:#e8f5e9,stroke:#2e7d32,color:#000
    classDef err fill:#ffebee,stroke:#c62828,color:#000

    START(("●")):::start
    GET["Запись из<br/>raw_events"]:::proc
    LLM["Нормализация<br/>через LLM"]:::ai
    VALID{"Схема<br/>верна?"}:::dec
    FAIL["status =<br/>failed"]:::err
    ISIT{"IT-событие?"}:::dec
    NONIT["status =<br/>non_it"]:::err
    EMBED["Построить<br/>вектор события"]:::ai
    DUP{"Дубликат?<br/>cosine ≥ 0.92"}:::dec
    SKIP["status =<br/>duplicate"]:::err
    ENRICH["Оценки качества,<br/>хайпа, темы,<br/>стек, аудитория"]:::ai
    SAVE["Запись в<br/>таблицу events"]:::db
    END_N(("●")):::start

    START --> GET --> LLM --> VALID
    VALID -->|"нет"| FAIL
    VALID -->|"да"| ISIT
    ISIT -->|"нет"| NONIT
    ISIT -->|"да"| EMBED --> DUP
    DUP -->|"да"| SKIP
    DUP -->|"нет"| ENRICH --> SAVE --> END_N

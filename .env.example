# EventMind v2 — пример окружения. Скопируй в .env и заполни секреты.
# `.env` НЕ коммитить (см. .gitignore). Значения по умолчанию рассчитаны на
# dev-стек `make up` (сервисы postgres/redis/mailhog внутри compose-сети).

# ── окружение ──────────────────────────────────────────────────────────────
ENVIRONMENT=dev            # dev | staging | prod
LOG_LEVEL=INFO
LOG_JSON=true              # false — человекочитаемый вывод в dev

# ── хранилища ───────────────────────────────────────────────────────────────
# async-драйвер (asyncpg). В compose api получает этот URL из окружения сервиса.
DATABASE_URL=postgresql+asyncpg://eventmind:eventmind@postgres:5432/eventmind
REDIS_URL=redis://redis:6379/0

# ── api ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Внутренний shared-secret для вызовов worker↔api, bot↔api (hmac).
# Пустой = open-mode (только dev). На проде — обязательно задать.
API_SHARED_SECRET=
# Секрет подписи пользовательских JWT (M1). Пустой валиден только в dev.
JWT_SECRET=

# ── наблюдаемость ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_NAME=eventmind-api

# ── LLM (M2): хотя бы один ключ понадобится для нормализации/рекомендаций ─────
# Цепочка: DeepSeek → Gemini → Groq 70b → Groq 8b (звенья без ключа пропускаются).
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=           # через запятую, порядок перебора; пусто — deepseek-flash
GOOGLE_API_KEY=
GOOGLE_MODEL=              # пусто — автопроба подберёт рабочую Gemini
GROQ_API_KEY=

# ── email-канал ──────────────────────────────────────────────────────────────
# dev: Mailhog (host=mailhog, port=1025, без TLS — письма ловятся на :8025).
# prod: Yandex (smtp.yandex.ru:465 SSL) или Mail.ru (smtp.mail.ru:465 SSL),
#       app-password в SMTP_PASSWORD.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false         # true для STARTTLS (587)
SMTP_USE_SSL=false         # true для SSL (465) — Yandex/Mail.ru
EMAIL_FROM=EventMind <noreply@eventmind.local>

# ── ingestion (M3) ───────────────────────────────────────────────────────────
# RSS/Atom-ленты через запятую (пусто — источник rss отключён; habr/kudago всегда).
RSS_FEEDS=
NORMALIZE_BATCH_SIZE=20
MAX_NORMALIZE_RETRIES=3
# Загрузка всех источников по расписанию (cron в worker): часы UTC через запятую;
# пусто — выключено. Новые сырые события worker сам нормализует (LLM-вызовы).
INGEST_SCHEDULE_HOURS=0,6,12,18
# Догрузка эмбеддингов событиям без вектора (cron в worker, раз в час): лимит за прогон.
EMBEDDING_BACKFILL_LIMIT=500
# Текст для эмбеддинга события: raw (с сайта) | summary (каноническое LLM-описание) | both.
EMBEDDING_TEXT_MODE=raw
# Семантическая дедупликация между источниками: cosine ≥ DEDUP_SIMILARITY — дубль;
# серая зона [DEDUP_UNCERTAIN_SIMILARITY; DEDUP_SIMILARITY) — решает LLM-арбитр.
DEDUP_ENABLED=true
DEDUP_SIMILARITY=0.92
DEDUP_UNCERTAIN_SIMILARITY=0.85
DEDUP_LLM_ARBITER=true

# ── рекомендер ───────────────────────────────────────────────────────────────
# Откалиброванные веса гибрида (python -m eval.real.calibrate), JSON; пусто — по умолчанию.
SCORING_WEIGHTS=

# ── поиск (P1 №7, №16) ───────────────────────────────────────────────────────
SEARCH_HYBRID_ENABLED=true   # строгий + полнотекстовый + семантический поиск (RRF)
SEARCH_HYDE_ENABLED=false    # HyDE: +1 вызов LLM на запрос, лучше на коротких запросах
SEARCH_MIN_SIMILARITY=0.3    # порог cosine для семантического ретривера

# ── диалоговый агент (A1–A5) ─────────────────────────────────────────────────
# false — свободный текст в боте идёт в NL-поиск, веб-чат «Помощник» отключён.
AGENT_ENABLED=true
AGENT_MAX_STEPS=5                 # вызовов LLM на один ход
AGENT_MAX_TOKENS_PER_TURN=24000   # лимит токенов на ход
AGENT_SESSION_TTL_SECONDS=3600    # сколько живёт история диалога

# ── telegram (M7) ────────────────────────────────────────────────────────────
BOT_TOKEN=                  # токен бота от @BotFather; пусто — процесс bot не стартует
TELEGRAM_BOT_USERNAME=      # без @; для deep-link https://t.me/<username>?start=<token>
PUBLIC_WEB_URL=http://localhost:3000
# Базовый URL API для процесса bot (bot↔api по X-API-Key). В compose — http://api:8000.
API_INTERNAL_URL=http://api:8000

# ── Google OAuth (M6) ────────────────────────────────────────────────────────
# OAuth2 client_id для «Sign in with Google». Пусто — соц-логин выключен
# (POST /api/v1/auth/google вернёт invalid_credentials). Проверка id_token —
# через tokeninfo, aud сверяется с этим значением.
GOOGLE_OAUTH_CLIENT_ID=

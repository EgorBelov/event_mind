# EventMind v2 — пример окружения. Скопируй в .env и заполни секреты.
# `.env` НЕ коммитить (см. .gitignore). Значения по умолчанию рассчитаны на
# dev-стек `make up` (сервисы postgres/redis/mailhog внутри compose-сети).

# ── окружение ──────────────────────────────────────────────────────────────
ENVIRONMENT=dev            # dev | staging | prod
LOG_LEVEL=INFO
LOG_JSON=true              # false — человекочитаемый вывод в dev

# ── хранилища ───────────────────────────────────────────────────────────────
# async-драйвер (asyncpg). В compose api получает этот URL из окружения сервиса.
DATABASE_URL=postgresql+asyncpg://eventmind:eventmind@postgres:5432/eventmind
REDIS_URL=redis://redis:6379/0

# ── api ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Внутренний shared-secret для вызовов worker↔api, bot↔api (hmac).
# Пустой = open-mode (только dev). На проде — обязательно задать.
API_SHARED_SECRET=
# Секрет подписи пользовательских JWT (M1). Пустой валиден только в dev.
JWT_SECRET=

# ── наблюдаемость ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_NAME=eventmind-api

# ── LLM (M2): хотя бы один ключ понадобится для нормализации/рекомендаций ─────
GOOGLE_API_KEY=
GOOGLE_MODEL=              # пусто — автопроба подберёт рабочую Gemini
GROQ_API_KEY=

# ── email-канал ──────────────────────────────────────────────────────────────
# dev: Mailhog (host=mailhog, port=1025, без TLS — письма ловятся на :8025).
# prod: Yandex (smtp.yandex.ru:465 SSL) или Mail.ru (smtp.mail.ru:465 SSL),
#       app-password в SMTP_PASSWORD.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false         # true для STARTTLS (587)
SMTP_USE_SSL=false         # true для SSL (465) — Yandex/Mail.ru
EMAIL_FROM=EventMind <noreply@eventmind.local>

# ── telegram (M7) ────────────────────────────────────────────────────────────
BOT_TOKEN=
PUBLIC_WEB_URL=http://localhost:3000

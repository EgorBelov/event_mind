# Шаблон окружения EventMind. Скопируй в .env и заполни секреты.
#   macOS/Linux: cp .env.example .env
#   Windows:     Copy-Item .env.example .env
# .env в .gitignore — секреты не коммитятся.

# ── Обязательное ────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=
# Ключ Groq API (https://console.groq.com)
GROQ_API_KEY=

# ── База данных ─────────────────────────────────────────────────────────
# dev: SQLite-файл; prod: postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./eventmind.db
# Базовый URL API (бот и scheduler ходят сюда)
API_HOST=http://localhost:8000

# ── LLM ─────────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# GROQ_TEMPERATURE=0.4

# ── Ingestion ───────────────────────────────────────────────────────────
# RSS/Atom-ленты через запятую
RSS_FEEDS=
INGEST_ENABLED=true
INGEST_INTERVAL_HOURS=6
INGEST_HABR_LIMIT=20
INGEST_RSS_LIMIT_PER_FEED=20
# Telegram-каналы для ingestion: @channel1,@channel2 (нужны TG_API_ID/HASH)
TG_INGEST_CHANNELS=
# TG_API_ID=
# TG_API_HASH=

# ── Дайджест (dev: видеть рассылку сразу) ───────────────────────────────
# DIGEST_INTERVAL_MINUTES=10
# DIGEST_RUN_ON_STARTUP=true

# ── Фичефлаги рекомендера ───────────────────────────────────────────────
# GNN_ENABLED=false      # на малом датасете шумит
# MEMORY_ENABLED=true    # long-term память пользователя
# DEBUG=false
